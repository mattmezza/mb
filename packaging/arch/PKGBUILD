pkgname=mb-browser
pkgver=0.1.0
pkgrel=1
_repo_root="${MB_REPO_ROOT:-${startdir}/../..}"
pkgdesc="$(python -c 'import pathlib,sys,tomllib; print(tomllib.loads(pathlib.Path(sys.argv[1]).read_text())["product"]["description"])' "${_repo_root}/mb/branding.toml")"
arch=('x86_64')
url='https://github.com/mattmezza/mb'
license=('BSD-3-Clause')
depends=('alsa-lib' 'at-spi2-core' 'cairo' 'cups' 'dbus' 'expat' 'fontconfig'
         'glib2' 'gtk3' 'libdrm' 'libx11' 'libxcb' 'libxcomposite' 'libxdamage'
         'libxext' 'libxfixes' 'libxrandr' 'libxshmfence' 'libxss' 'libxtst'
         'mesa' 'nspr' 'nss' 'pango')
makedepends=('python')
options=('!strip')

_release_output="${MB_RELEASE_OUTPUT:-${_repo_root}/.build/chromium/src/out/mb-release}"
_release_receipt="${MB_RELEASE_RECEIPT:?Set MB_RELEASE_RECEIPT to the successful release build receipt}"

package() {
  python "${_repo_root}/packaging/arch/stage_release.py" \
    --repo-root "${_repo_root}" \
    --output-dir "${_release_output}" \
    --build-receipt "${_release_receipt}" \
    --destination "${pkgdir}"
}
