# Unmodified Chromium baseline. Keep security and browser feature defaults.
is_debug = true
is_component_build = true
symbol_level = 1
blink_symbol_level = 0
v8_symbol_level = 0
use_siso = true
use_remoteexec = false
ozone_platform_x11 = true
is_chrome_branded = false

# Product identity derives from mb/branding.toml through product.py prepare.
branding_path_product = "chromium"
branding_path_component = "mb"
branding_file_path = "//mb/generated/branding/BRANDING"
generate_about_credits = true
