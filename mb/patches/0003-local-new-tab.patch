diff --git a/chrome/browser/search/search.cc b/chrome/browser/search/search.cc
--- a/chrome/browser/search/search.cc
+++ b/chrome/browser/search/search.cc
@@ -176,10 +176,13 @@
     const GURL local_url;
 #else
     const bool default_is_google = DefaultSearchProviderIsGoogle(profile);
-    const GURL local_url(default_is_google
+    // mb's built-in NTP is bundled locally, independently of the search
+    // provider. Extension overrides have already run before this rewrite.
+    const bool use_local_ntp = BUILDFLAG(IS_LINUX) || default_is_google;
+    const GURL local_url(use_local_ntp
                              ? chrome::ChromeUINewTabPageURLAsGURL()
                              : GURL(chrome::kChromeUINewTabPageThirdPartyURL));
-    if (default_is_google) {
+    if (use_local_ntp) {
       return NewTabURLDetails(local_url, NEW_TAB_URL_VALID);
     }
 #endif
