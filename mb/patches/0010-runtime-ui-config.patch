 #include "chrome/browser/browser_features.h"
@@ -1580,6 +1587,22 @@
 
 void ChromeBrowserMainParts::PostProfileInit(Profile* profile,
                                              bool is_initial_profile) {
+#if BUILDFLAG(IS_LINUX)
+  if (const auto* snapshot = mb::GetProcessRuntimeConfig();
+      snapshot && profile->IsRegularProfile()) {
+    if (auto theme = mb::InitializeRuntimeUiConfig(
+            profile, profile->GetPrefs(), snapshot->config.ui)) {
+      auto scheme = ThemeService::BrowserColorScheme::kSystem;
+      switch (*theme) {
+        case mb::config::Theme::kSystem: break;
+        case mb::config::Theme::kLight: scheme = ThemeService::BrowserColorScheme::kLight; break;
+        case mb::config::Theme::kDark: scheme = ThemeService::BrowserColorScheme::kDark; break;
+      }
+      ThemeServiceFactory::GetForProfile(profile)->SetBrowserColorScheme(scheme);
+      mb::RecordRuntimeThemeApplied(profile);
+    }
+  }
+#endif
   if (is_initial_profile) {
     TRACE_EVENT0("startup", "ChromeBrowserMainParts::PostProfileInit");
   }
