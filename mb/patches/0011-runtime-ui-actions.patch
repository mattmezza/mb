     StartupTabs prefs_tabs =
         provider.GetPreferencesTabs(*command_line_, profile_);
 
+#if BUILDFLAG(IS_LINUX)
+    // This slot is reached only without explicit URLs, outside OTR/guest and
+    // crash recovery. Preserve native session restore and configured policies.
+    if (process_startup == chrome::startup::IsProcessStartup::kYes &&
+        profile_->IsRegularProfile() && prefs_tabs.empty() &&
+        !StartupBrowserCreator::GetSessionStartupPref(*command_line_, profile_)
+             .ShouldRestoreLastSession() &&
+        !SessionStartupPref::TypeIsManaged(profile_->GetPrefs()) &&
+        !SessionStartupPref::URLsAreManaged(profile_->GetPrefs()) &&
+        !SessionStartupPref::TypeHasRecommendedValue(profile_->GetPrefs())) {
+      for (const auto& url : mb::GetConfiguredStartupUrls()) {
+        prefs_tabs.emplace_back(url);
+      }
+    }
+#endif
     bool prefs_tabs_originally_empty = prefs_tabs.empty();
 
     // Filter out tabs from preferences that are already pinned.
